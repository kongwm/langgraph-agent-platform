# === 复制为 .env 并填入真实值（.env 已被 .gitignore 排除） ===

# 运行环境：dev / prod（决定叠加 .env.dev 还是 .env.prod，见 core/config.py）
APP_ENV=dev

# --- LLM（GLM 的 Anthropic 兼容端点，同 platform/backend） ---
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_API_KEY=
MODEL_MAIN=glm-5.3
MODEL_CHEAP=glm-4.5-air

# --- 数据库（docker-compose.yml 起的本机容器，端口 25432） ---
# 业务库：conversations / users（Alembic 迁移管理）
DATABASE_URL=postgresql://agent:agent_dev@localhost:25432/agent_platform
# 框架库：LangGraph checkpointer 表（setup() 自建，勿手工改）
CHECKPOINT_DB_URL=postgresql://agent:agent_dev@localhost:25432/agent_platform_meta

# --- 服务 ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# --- 预留（P10.5 可观测：默认关闭，不开外发） ---
# LANGSMITH_API_KEY=
# OTEL_EXPORTER_OTLP_ENDPOINT=
